classDiagram

class Entreprise {
  +INTEGER id PK
  +STRING nom
  +STRING email UNIQUE
  +STRING motDePasseHash
  +STRING secteur
}

class Transaction {
  +INTEGER id PK
  +INTEGER entrepriseId FK
  +ENUM type
  +DECIMAL montant
  +STRING categorie
  +DATE date
}

class Conversation {
  +INTEGER id PK
  +INTEGER entrepriseId FK
  +DATETIME dateCreation
}

class Message {
  +INTEGER id PK
  +INTEGER conversationId FK
  +ENUM role
  +TEXT contenu
  +DATETIME horodatage
}

Entreprise "1" --> "0..*" Transaction : possede
Entreprise "1" --> "0..*" Conversation : initie
Conversation "1" --> "0..*" Message : contient

note for Transaction "type = revenu | depense"
note for Message "role = user | assistant"